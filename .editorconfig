# https://editorconfig.org — keeps whitespace consistent across editors so a
# contributor's IDE cannot introduce a diff the linters then reject.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
# Matches Black, which is authoritative here.
max_line_length = 88

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown; stripping them
# silently reflows paragraphs.
trim_trailing_whitespace = false

[Makefile]
# Recipe lines must begin with a literal tab.
indent_style = tab

[*.{sh,bash}]
indent_size = 2
