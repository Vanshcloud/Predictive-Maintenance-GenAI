# =============================================================================
# docker/Dockerfile.dashboard — Streamlit UI
# =============================================================================
# This image installs requirements-dashboard.txt, NOT requirements.txt: four
# packages instead of the full ML stack. That is the concrete payoff of the
# dashboard importing nothing from src/ — using the full requirements here
# would pull TensorFlow, scikit-learn and LangChain into an image whose entire
# job is calling `requests` and drawing charts.
#
# Only dashboard/ is copied. If a future change makes the UI import from src/,
# this build breaks — which is the intended failure.
# =============================================================================

FROM python:3.12-slim AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build

COPY requirements-dashboard.txt .
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && /opt/venv/bin/pip install -r requirements-dashboard.txt


# -----------------------------------------------------------------------------
FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH" \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

RUN useradd --create-home --shell /bin/bash appuser

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY --chown=appuser:appuser dashboard/ ./dashboard/

USER appuser

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD python -c "import sys, urllib.request; \
sys.exit(0 if urllib.request.urlopen('http://localhost:8501/_stcore/health', \
timeout=5).status == 200 else 1)"

CMD ["streamlit", "run", "dashboard/app.py", \
     "--server.port=8501", "--server.address=0.0.0.0"]
