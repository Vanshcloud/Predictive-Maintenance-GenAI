# ============================================================
# examples/.env.example — a worked configuration
# ============================================================
# The canonical template is ../.env.example. This one is annotated with the
# three decisions that actually matter and the values a real deployment uses.
#
#   cp examples/.env.example .env
# ============================================================

# --- Application ---
APP_ENV=production          # development | staging | production
DEBUG=false                 # never true in production — is_debug gates on both
LOG_LEVEL=INFO              # DEBUG is very chatty: it logs every cache hit
APP_VERSION=1.0.0           # surfaced by /health so an operator can identify the build

# --- Serving -------------------------------------------------------------
# DECISION 1: the alert threshold.
# 0.5 is inherited from balanced problems and is wrong here. This value was
# chosen by sweeping the precision-recall curve on the VALIDATION split; the
# test set was scored once, at this point. Do not tune it against test.
PREDICTION_THRESHOLD=0.3415

# DECISION 2: the risk bands.
# RISK_BAND_HIGH must EQUAL PREDICTION_THRESHOLD, so that "high or above" means
# exactly "the model is alerting". A test fails if they drift apart. MEDIUM sits
# at ~44% of the threshold; CRITICAL is near-certainty.
RISK_BAND_MEDIUM=0.15
RISK_BAND_HIGH=0.3415
RISK_BAND_CRITICAL=0.90

# --- LLM provider --------------------------------------------------------
# DECISION 3: which provider, and whether you need one at all.
# None of these is required. With no key set, prediction endpoints work fully
# and /report degrades to a 502 that still carries the prediction.
#
# Keyless local model (needs: pip install -e ".[ollama]"):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
#
# From inside a container, the host's Ollama is not localhost:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
#
# Hosted providers — leave unset to use Ollama. Placeholder values such as
# "your-openai-api-key-here" are deliberately treated as UNSET, so a copied
# template cannot be mistaken for a real credential.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# GOOGLE_API_KEY=...            # needs: pip install -e ".[google]"
# GOOGLE_MODEL=gemini-1.5-flash

# --- Paths ---------------------------------------------------------------
MODEL_DIR=models
MODEL_NAME=lstm_predictive_maintenance
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# --- Network -------------------------------------------------------------
API_HOST=0.0.0.0            # bind 127.0.0.1 if a reverse proxy fronts this
API_PORT=8000
DASHBOARD_PORT=8501         # also the origin the API's CORS policy allows
